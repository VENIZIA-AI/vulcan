# `make help` - the target list. Keep it in step with the other make/*.mk files.
# Every row goes through HELP_ROW, so the descriptions start in one column; widen HELP_WIDTH when
# a longer name is added.

HELP_WIDTH := 34
HELP_ROW = printf "  %-$(HELP_WIDTH)s %s\n"

.PHONY: help

help:
	@echo "Makefile for the VULCAN monorepo"
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@echo "Main Targets:"
	@$(HELP_ROW) "help" "Show this help message (a bare 'make' does the same)."
	@$(HELP_ROW) "build" "Rebuilds all packages (alias for 'build-all')."
	@$(HELP_ROW) "build-all" "Rebuilds all packages in order."
	@$(HELP_ROW) "docs" "Build the wiki site (VitePress) into docs/wiki/site/.vitepress/dist."
	@$(HELP_ROW) "install" "Install all dependencies with bun."
	@$(HELP_ROW) "clean" "Clean build artifacts from all packages."
	@$(HELP_ROW) "setup-hooks" "Configure git to use .githooks directory."
	@echo ""
	@echo "Per package - <pkg> is one of:"
	@echo "  $(PACKAGES)"
	@$(HELP_ROW) "<pkg>" "Rebuild one package."
	@$(HELP_ROW) "update-<pkg>" "Force update one package's dependencies from NPM."
	@$(HELP_ROW) "lint-<pkg>" "oxlint + ESLint (naming-convention) + bun fmt check of one package."
	@$(HELP_ROW) "fmt-<pkg>" "Apply oxlint --fix, ESLint --fix and bun fmt to one package."
	@$(HELP_ROW) "test-<pkg>" "Run one package's suite with BUN_TEST_FLAGS."
	@$(HELP_ROW) "smoke-<pkg>" "Pack one package, install it alone in an empty project, run it. Needs a build."
	@echo ""
	@echo "Every package and the repository:"
	@$(HELP_ROW) "lint / lint-packages" "lint-<pkg> for every package."
	@$(HELP_ROW) "lint-all" "lint-<pkg> for every package, lint-scripts, lint-files, then project-names-check."
	@$(HELP_ROW) "project-names-check" "Gate: no project name (IGNIS, ARDOR, BANA) in packages/*/src outside tests."
	@$(HELP_ROW) "lint-scripts" "bun check of the root scripts/."
	@$(HELP_ROW) "lint-files" "bun fmt check of every file outside packages/ (code, json, yaml, css, html, vue; not Markdown)."
	@$(HELP_ROW) "fmt / lint-fix / fmt-packages" "fmt-<pkg> for every package, then fmt-files (lint-fix is the library target name)."
	@$(HELP_ROW) "typecheck / typecheck-packages" "bun check of every package, including the emit configs (typecheck-<pkg> for one)."
	@$(HELP_ROW) "test" "test-<pkg> for every package (alias of test-all)."
	@$(HELP_ROW) "test-all" "test-<pkg> for every package, then test-scripts (BUN_TEST_FLAGS)."
	@$(HELP_ROW) "test-scripts" "The root scripts/ tests (every group; part of test-all)."
	@echo ""
	@echo "Release:"
	@$(HELP_ROW) "catalog-check" "Every catalogued dependency is referenced as catalog:, none unused."
	@$(HELP_ROW) "release-plan [ARGS=...]" "Print the release dispatch (scripts/release/release.ts --dry-run)."
	@$(HELP_ROW) "release [ARGS=...]" "Dispatch package-release.yml for the okf/atlas/cli train and watch it."
	@echo ""
	@echo "Skill evals (real model calls - they spend quota; plan first):"
	@$(HELP_ROW) "skill-evals-plan SKILL=<name>" "Print every eval x model run, its command and paths; run nothing."
	@$(HELP_ROW) "skill-evals SKILL=<name>" "Run a skill's evals across MODELS=haiku,sonnet,opus in PROJECT, grade, report."
	@echo ""
	@echo "Shipped VULCAN targets (node_modules/@venizia/vulcan/base/make/vulcan.mk):"
	@$(HELP_ROW) "vulcan-sync / agent-setup" "Write CLAUDE.md, .claude/settings.json and the skill links."
	@$(HELP_ROW) "vulcan-doctor" "Check this repository follows VULCAN; exit 1 on any violation."
	@$(HELP_ROW) "okf-check" "Gate: OKF v0.2 conformance of .agents/knowledge; warnings never fail."
	@$(HELP_ROW) "okf-check-strict" "okf-check plus the house rules: links, style, coverage, freshness."
	@$(HELP_ROW) "okf-gen / okf-coverage / okf-viz" "Generate, report and visualize the bundle."
	@$(HELP_ROW) "surface-gen / surface-check" "Write the public API surface from the built .d.ts, or fail when it drifted."
	@$(HELP_ROW) "atlas-symbols / atlas-releases" "Print the symbols atlas reads from the .d.ts, or the releases it computes from the tags."
	@$(HELP_ROW) "changelogs-migrate" "Write the packages: list into changelog entries that declare none."
	@$(HELP_ROW) "knowledge-symbols-check" "Fail when a symbol a concept names is gone or its signature changed."
	@echo ""
	@echo "Development (use bun run directly):"
	@$(HELP_ROW) "vulcan x atlas mcp --root <dir>" "Start the atlas MCP server over a project (default: the working directory)."
