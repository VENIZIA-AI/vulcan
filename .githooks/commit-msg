#!/bin/bash

# ----------------------------------------------------------------------------
# Commit-msg Hook
# Checks the commit message against commit.message in .configs/vulcan.config.mts: no agent
# signature (W-00). The check ships in @venizia/vulcan as `vulcan check commit`.
# ----------------------------------------------------------------------------

set -e

cd "$(git rev-parse --show-toplevel)"

exec bun node_modules/.bin/vulcan check commit "$1"
