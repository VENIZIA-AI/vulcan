#!/bin/bash

# ----------------------------------------------------------------------------
# Commit-msg Hook
# Checks the commit message against commit.message in .configs/vulcan.config.mts: no agent
# signature (W-00). The check ships in @venizia/vulcan as `vulcan commit-check`.
# ----------------------------------------------------------------------------

set -e

cd "$(git rev-parse --show-toplevel)"

exec bun x --no-install vulcan commit-check "$1"
