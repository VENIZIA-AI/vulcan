{
  "name": "@venizia/vulcan-okf",
  "version": "0.1.0-1",
  "description": "VULCAN knowledge tooling: OKF v0.2 conformance check (plus --strict house rules), gen, coverage and the offline graph explorer for a project's .agents/knowledge bundle. Bun-only.",
  "homepage": "https://github.com/VENIZIA-AI/vulcan/tree/main/packages/okf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/vulcan.git",
    "directory": "packages/okf"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/vulcan/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "bin": {
    "vulcan-okf": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "src",
    "!src/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/force-update.sh",
    "test": "NODE_ENV=test bun test --env-file=.env.test"
  },
  "dependencies": {
    "cytoscape": "catalog:",
    "cytoscape-fcose": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/cytoscape-fcose": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@venizia/ignis-helpers": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "sideEffects": false
}
