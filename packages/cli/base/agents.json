[
  {
    "id": "claude",
    "name": "Claude Code",
    "detect": {
      "binaries": ["claude"],
      "homeDirs": ["~/.claude"],
      "projectDirs": [".claude"]
    },
    "instructions": {
      "nativeAgentsMd": false,
      "shim": {
        "path": "CLAUDE.md",
        "content": "@AGENTS.md"
      }
    },
    "mcp": {
      "scope": "shared",
      "path": ".mcp.json",
      "renderer": "mcpServers"
    },
    "skills": {
      "dir": ".claude/skills"
    },
    "instructionsSurfaced": true,
    "notes": []
  },
