{
  "name": "@venizia/vulcan",
  "version": "0.3.13",
  "description": "VULCAN - one setup, one workflow for every project: init, sync, doctor, upgrade, and `vulcan x` for the shipped tools. Bun-only.",
  "homepage": "https://github.com/VENIZIA-AI/vulcan/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/vulcan/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/vulcan.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vulcan": "./src/cli.ts"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "src",
    "base",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./okf": "./src/okf.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@venizia/vulcan-atlas": "workspace:*",
    "@venizia/vulcan-okf": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
