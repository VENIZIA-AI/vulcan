{
  "name": "@venizia/vulcan-atlas",
  "version": "0.2.0-1",
  "description": "MCP knowledge server: search and read the wiki, changelogs and knowledge bundle by section, with citations. Bun-only, zero-dependency transport.",
  "homepage": "https://github.com/VENIZIA-AI/vulcan/tree/main/packages/atlas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/vulcan.git",
    "directory": "packages/atlas"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/vulcan/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "bin": {
    "vulcan-atlas": "./dist/cjs/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!/**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "force-update": "sh ../../scripts/force-update.sh",
    "prepublishOnly": "make rebuild",
    "test": "NODE_ENV=test bun test --env-file=.env.test",
    "test:watch": "NODE_ENV=test bun test --watch --env-file=.env.test"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:"
  }
}
