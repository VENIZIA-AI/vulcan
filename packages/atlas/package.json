{
  "name": "@venizia/vulcan-atlas",
  "version": "0.4.8",
  "description": "MCP knowledge server: search and read the wiki, changelogs and knowledge bundle by section, with citations. Bun-only, zero-dependency transport.",
  "homepage": "https://github.com/VENIZIA-AI/vulcan/tree/main/packages/atlas",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/vulcan/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/vulcan.git",
    "directory": "packages/atlas"
  },
  "bin": {
    "vulcan-atlas": "./dist/cjs/cli.js"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild",
    "test": "bun test"
  },
  "dependencies": {
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
