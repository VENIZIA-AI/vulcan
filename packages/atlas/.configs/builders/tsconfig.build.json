{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "../../dist/esm",
    "declarationDir": "../../dist/esm"
  },
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/__tests__",
    "../../**/*.test.ts",
    "../../**/*.spec.ts"
  ]
}
